# ==========================================
# UD-SUD-Flow — Git ignore rules
# ==========================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Python testing
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Credentials and environment variables
.env
.env.*
*.pem
*.key

# Temporary files
*.tmp
*.log

# Local corpus data and generated outputs
data/
outputs/

# Jupyter
.ipynb_checkpoints/
